# Clave del proveedor de IA. Sin valor por defecto a proposito: la app cae al
# arrancar en vez de quedarse funcionando a medias.
OPENROUTER_API_KEY=sk-CAMBIAME

# Cualquier API con formato OpenAI. DeepSeek directo evita el margen de
# OpenRouter; para comparar modelos de otros fabricantes, https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.deepseek.com
MODELO_TRANSCRIPCION=deepseek-v4-flash-vision-exp
MODELO_RESUMEN=deepseek-v4-pro
MODELO_PREGUNTAS=deepseek-v4-pro

DB_PATH=data/estudia.db

# Dos topes de gasto. El global protege la factura; el de por usuario evita que
# el primero que se registre la queme entera y deje la app inservible.
TOPE_GASTO_MENSUAL_USD=5.0
TOPE_GASTO_USUARIO_USD=1.0
